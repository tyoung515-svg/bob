# Private deployment environment. Never use these placeholder secrets unchanged.
# The Ubuntu installer creates this file and a matching lane.env automatically.
# Values below describe the standalone single-admin-lane layout.
BOBCLAW_SECRET=replace-with-at-least-32-random-characters
JWT_SECRET=replace-with-another-32-random-characters
# Plaintext password, read by gateway auth. There is no PASSWORD_HASH setting.
BOBCLAW_PASSWORD=replace-with-a-random-login-password
TOTP_SECRET=replace-with-a-random-base32-seed

# Required: no database-password fallback in compose.
POSTGRES_PASSWORD=replace-with-a-random-url-safe-database-password
POSTGRES_URL=postgresql://bobclaw:replace-with-a-random-url-safe-database-password@127.0.0.1:5432/bobclaw
REDIS_URL=redis://127.0.0.1:6379/0
MEMORY_QDRANT_URL=http://127.0.0.1:6353
COMPOSE_PROJECT_NAME=bobclaw
BOBCLAW_PG_PORT=5432
BOBCLAW_REDIS_PORT=6379
BOBCLAW_QDRANT_PORT=6353
BOBCLAW_QDRANT_GRPC_PORT=6354

BOB_FAMILY_ROOT=/var/lib/bob-source/family
# Standalone password login uses the existing admin subject.
BOB_DEFAULT_OWNER=admin
BOB_MEMORY_OWNERS=admin
BOB_LANE_ROOT=/var/lib/bob-source/family/admin/bob-memory
# Keep BOB_ROSTER_FILE UNSET for configured-lane mode, including in the shell.
# Alternative explicit roster mode (does not enroll model seats):
# BOB_ROSTER_FILE=/path/to/bob/bobclaw-core/config/roster.example.yaml
# Provider selection/credentials must also be in the lane's lane.env/providers.env.
BOB_LANE_BACKENDS=local
BOB_LANE_DEFAULT_BACKEND=local
OLLAMA_URL=http://127.0.0.1:11434
PREFERRED_LOCAL_MODEL=
# Optional cloud enrollment example; configure in the lane's providers.env.
# BOB_LANE_BACKENDS=claude_api
# BOB_LANE_DEFAULT_BACKEND=claude_api
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=your-entitled-model-id

BOBCLAW_CORE_HOST=127.0.0.1
BOBCLAW_CORE_PORT=7835
BOBCLAW_GATEWAY_HOST=127.0.0.1
BOBCLAW_GATEWAY_PORT=7836
CORE_URL=http://127.0.0.1:7835
BOBCLAW_GATEWAY_URL=http://127.0.0.1:7836
GATEWAY_SQLITE_PATH=/var/lib/bob-source/family/admin/bob-memory/gateway.db
MEMORY_SQLITE_PATH=/var/lib/bob-source/family/admin/bob-memory/bobclaw_memory.db
MEMORY_ENABLED=false
MEMORY_L1_EXTRACTION_ENABLED=false
# Source hosts have no image worker daemon. Required on non-Linux hosts too.
BUILD_SANDBOX=docker
BUILD_WORKSPACE_ROOT=/var/lib/bob-source/family/admin/bob-memory/scratch/build
BOB_OWNER_WORK_APPROVAL=signed_in_user
# Broker refuses startup without this variable or an explicit --token-file.
BOB_BROKER_TOKEN_FILE=/var/lib/bob-source/family/admin/bob-memory/broker.token
LOG_LEVEL=INFO
