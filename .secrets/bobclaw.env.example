# BoBClaw Environment Configuration
# Copy this to bobclaw.env and fill in your values

# ── Server ────────────────────────────────────────────
BOBCLAW_SECRET=change-me-to-a-random-string
BOBCLAW_PASSWORD=change-me

# ── Database ──────────────────────────────────────────
# docker-compose.yml reads POSTGRES_PASSWORD from THIS file:
#   docker compose --env-file .secrets/bobclaw.env -f docker-compose.yml up -d
# There is NO default — compose fails closed if POSTGRES_PASSWORD is unset. Keep
# the password inside POSTGRES_URL identical to POSTGRES_PASSWORD.
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_URL=postgresql://bobclaw:change-me-to-a-strong-password@localhost:5432/bobclaw

# ── Local Model Backends ──────────────────────────────
OLLAMA_URL=http://localhost:11434
LMSTUDIO_URL=http://localhost:1234

# ── Claude API ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Gemini API ────────────────────────────────────────
# Uses API key + model selection per SKU
GOOGLE_API_KEY=AIza...
GEMINI_FLASH_MODEL=gemini-3-flash-preview
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_DEEP_RESEARCH_MODEL=gemini-3.1-pro-preview

# ── Email MCP ─────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── Kimi API (coding) ─────────────────────────────────
# Get from https://www.kimi.com/code/console
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.7-code

# ── DeepSeek API (OpenAI-compat) ──────────────────────
# Get from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ── MiniMax M3 API (OpenAI-compat) ────────────────────
# intl=https://api.minimax.io/v1 , CN=https://api.minimaxi.com/v1 (verify on console)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3

# ── Kimi Platform (PAYG fallback) ─────────────────────
# Get from https://platform.moonshot.cn/console
MOONSHOT_API_KEY=
KIMI_PLATFORM_BASE_URL=https://api.moonshot.cn/v1
KIMI_PLATFORM_MODEL=kimi-k2.6
KIMI_PLATFORM_DAILY_USD_LIMIT=20.00
KIMI_PLATFORM_DAILY_USD_WARN=10.00

# ── OpenCode workers ──────────────────────────────────
# Comma-separated host:port:workspace_dir triples
# Example: localhost:7900:C:\dev\repo-a,localhost:7901:C:\dev\repo-b
OPENCODE_INSTANCES=
OPENCODE_DEFAULT_TIMEOUT_S=300
OPENCODE_HEALTH_PROBE_INTERVAL_S=60

# ── Claude Code planning tier ─────────────────────────
# Optional; unset CC_CLI_PATH resolves "claude" on PATH.
CC_CLI_PATH=
# CC_PROJECT_DIR defaults to the BoBClaw repo root; uncomment to override.
# CC_PROJECT_DIR=C:\dev\projects\bobclaw
CC_TIMEOUT_SECONDS=300
CC_SIDECAR_PATH=./data/cc_session_sidecar.jsonl
# C4: when true, an approved cc_edit diff is applied via core-direct git apply
# (check-first, no commit). Default false = capture + surface only, no write.
CC_EDIT_APPLY_ENABLED=false

# ── Telegram pilot (bobclaw-telegram, phase 3A) ───────
# BotFather token; comma-separated NUMERIC Telegram user ids (fail-closed,
# never usernames). BOBCLAW_GATEWAY defaults to 127.0.0.1:7836.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# ── Optional ──────────────────────────────────────────
TOTP_SECRET=
LOG_LEVEL=INFO
