<mxCell id="p2_note_regex" value="Heuristic regexes (route.py)
_PLAN_INTENT  =  plan|design|architect|spec|roadmap|decompose|break\s+down|figure\s+out\s+how|propose|outline|map\s+out|scope
_CODE_SHAPED  =  refactor|migrate|implement|integrate|repo|module|class|function|endpoint|api|test|build|compile|deploy|pipeline|service|backend|frontend|schema|sql|crud|fix|patch|bug|merge|pr|commit|library|package|dependency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d381a;strokeColor=#c9b558;fontSize=10;align=left;spacingLeft=8;fontColor=#fff3a8" vertex="1" parent="1"><mxGeometry x="20" y="830" width="1160" height="90" as="geometry"/></mxCell>
<mxCell id="p2_note_swap" value="On any swap, route_node appends a system message:
  &quot;Face swap: &#x27;&lt;old&gt;&#x27; → &#x27;&lt;new&gt;&#x27;&quot;
and writes face_id, backend, escalation_backend back into AgentState." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d381a;strokeColor=#c9b558;fontSize=10;align=left;spacingLeft=8;fontColor=#fff3a8" vertex="1" parent="1"><mxGeometry x="20" y="940" width="1160" height="60" as="geometry"/></mxCell>
