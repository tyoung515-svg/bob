<mxCell id="p2_e13" value="" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#c8cdd5;fontSize=10;fontColor=#e8eaed" edge="1" parent="1" source="p2_def" target="p2_face_as"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 · Worker fan-out" id="page-3"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="1380" math="0" shadow="0" background="#1e1e22"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3_title" value="Sprint 8 — Worker Fan-out (Send-based topology)
Source:  WORKER_FANOUT_DESIGN.md  ·  bobclaw-core/core/nodes/{dispatch,worker,join}.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d381a;strokeColor=#c9b558;fontSize=10;align=left;spacingLeft=8;fontColor=#fff3a8" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1320" height="50" as="geometry"/></mxCell>
<mxCell id="p3_dec" value="decompose_node
produces subtasks: list[str]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e4a2e;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#e0f5e8" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="60" as="geometry"/></mxCell>
<mxCell id="p3_rt" value="route_node
sets backend + escalation_backend
+ face swap" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e4a2e;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#e0f5e8" vertex="1" parent="1"><mxGeometry x="290" y="100" width="220" height="60" as="geometry"/></mxCell>
<mxCell id="p3_dis" value="dispatch_node
(state-mutation pre-flight)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e4a2e;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#e0f5e8" vertex="1" parent="1"><mxGeometry x="540" y="100" width="220" height="60" as="geometry"/></mxCell>
<mxCell id="p3_chk_box" value="dispatch_node — ordered pre-flight (handoffs 005-008)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a2d4a;strokeColor=#a78bcc;fontStyle=1;fontColor=#e8d6ff;align=center;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="40" y="200" width="720" height="30" as="geometry"/></mxCell>
<mxCell id="p3_c1" value="1.  Workspace bypass — backend == opencode_serve OR face_id == worker-opencode → return (no fan-out)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d2128;strokeColor=#d97a85;fontSize=10;align=left;spacingLeft=8;fontColor=#f8d7dc" vertex="1" parent="1"><mxGeometry x="40" y="240" width="720" height="38" as="geometry"/></mxCell>
<mxCell id="p3_c2" value="2.  Single-subtask bypass — len(subtasks) ≤ 1 → return" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d2128;strokeColor=#d97a85;fontSize=10;align=left;spacingLeft=8;fontColor=#f8d7dc" vertex="1" parent="1"><mxGeometry x="40" y="282" width="720" height="38" as="geometry"/></mxCell>
<mxCell id="p3_c3" value="3.  Width determination — fanout_width override (≤1 → bypass) OR len(subtasks) ≥ _FANOUT_THRESHOLD (=5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d2128;strokeColor=#d97a85;fontSize=10;align=left;spacingLeft=8;fontColor=#f8d7dc" vertex="1" parent="1"><mxGeometry x="40" y="324" width="720" height="38" as="geometry"/></mxCell>
<mxCell id="p3_c4" value="4.  Global cap — n &gt; MAX_FANOUT_WIDTH_GLOBAL (=100) → set state.error, abort (no silent truncation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d2128;strokeColor=#d97a85;fontSize=10;align=left;spacingLeft=8;fontColor=#f8d7dc" vertex="1" parent="1"><mxGeometry x="40" y="366" width="720" height="38" as="geometry"/></mxCell>
<mxCell id="p3_c5" value="5.  Backend mapping — backend missing from MAX_FANOUT_WIDTH_BY_BACKEND or MAX_WORKER_USD_BY_BACKEND → ValueError" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d2128;strokeColor=#d97a85;fontSize=10;align=left;spacingLeft=8;fontColor=#f8d7dc" vertex="1" parent="1"><mxGeometry x="40" y="408" width="720" height="38" as="geometry"/></mxCell>
<mxCell id="p3_c6" value="6.  Per-backend cap + wave-chunking — kimi_code/platform=10 (hard) · claude_api=20 (soft) · opencode_serve/local=1.  Wave slice = subtasks[w·cap : (w+1)·cap]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d2128;strokeColor=#d97a85;fontSize=10;align=left;spacingLeft=8;fontColor=#f8d7dc" vertex="1" parent="1"><mxGeometry x="40" y="450" width="720" height="38" as="geometry"/></mxCell>
<mxCell id="p3_c7" value="7.  Cost pre-flight — sum(MAX_WORKER_USD_BY_BACKEND[backend] [+ critic]) &gt; remaining_budget(backend) → set error, abort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d2128;strokeColor=#d97a85;fontSize=10;align=left;spacingLeft=8;fontColor=#f8d7dc" vertex="1" parent="1"><mxGeometry x="40" y="492" width="720" height="38" as="geometry"/></mxCell>
<mxCell id="p3_c8" value="8.  Approval pre-check — any task_requires_approval(subtask) → combined approval_required + system message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d2128;strokeColor=#d97a85;fontSize=10;align=left;spacingLeft=8;fontColor=#f8d7dc" vertex="1" parent="1"><mxGeometry x="40" y="534" width="720" height="38" as="geometry"/></mxCell>
<mxCell id="p3_route" value="_route_after_dispatch(state)
state.error?  approval_required?  fanout?  fall-through?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#5a3a14;strokeColor=#e0a050;fontSize=11;fontColor=#ffe6cc" vertex="1" parent="1"><mxGeometry x="40" y="586" width="720" height="70" as="geometry"/></mxCell>
<mxCell id="p3_send" value="list[Send] →  worker(0..N-1)
Sub-state:
{ task: subtask_text, face_id, backend,
escalation_backend, subtask_idx, messages: [],
phase: dispatch, critic_backend, critic_prompt_template }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2b2f36;strokeColor=#7a8390;fontSize=11;fontColor=#e8eaed" vertex="1" parent="1"><mxGeometry x="800" y="100" width="540" height="130" as="geometry"/></mxCell>
<mxCell id="p3_wbox" value="worker_node × N  (parallel, asyncio.wait_for, WORKER_TIMEOUT_SECONDS=180)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a2d4a;strokeColor=#a78bcc;fontStyle=1;fontColor=#e8d6ff;align=center;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="800" y="250" width="540" height="30" as="geometry"/></mxCell>
<mxCell id="p3_w0" value="worker(0)
_send_to_backend" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e4a2e;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#e0f5e8" vertex="1" parent="1"><mxGeometry x="820" y="290" width="110" height="50" as="geometry"/></mxCell>
<mxCell id="p3_w1" value="worker(1)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e4a2e;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#e0f5e8" vertex="1" parent="1"><mxGeometry x="940" y="290" width="90" height="50" as="geometry"/></mxCell>
<mxCell id="p3_w2" value="worker(2)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e4a2e;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#e0f5e8" vertex="1" parent="1"><mxGeometry x="1040" y="290" width="90" height="50" as="geometry"/></mxCell>
<mxCell id="p3_wd" value="···" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e4a2e;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#e0f5e8" vertex="1" parent="1"><mxGeometry x="1140" y="290" width="50" height="50" as="geometry"/></mxCell>
<mxCell id="p3_wn" value="worker(N-1)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e4a2e;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#e0f5e8" vertex="1" parent="1"><mxGeometry x="1200" y="290" width="110" height="50" as="geometry"/></mxCell>
<mxCell id="p3_wnote" value="Each worker produces one worker_results entry:
{ idx, text, status: ok|failed|timeout|rejected,
 content?, error?, usage?, duration_ms, backend_used,
 critic_backend?, critic_verdict?, critic_reasons?, critic_duration_ms? }

429 detected via _looks_like_rate_limit → execute._pin_escalation (Redis 30-min TTL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d2128;strokeColor=#d97a85;fontSize=10;align=left;spacingLeft=8;fontColor=#f8d7dc" vertex="1" parent="1"><mxGeometry x="800" y="360" width="540" height="130" as="geometry"/></mxCell>
<mxCell id="p3_critic" value="if face.critic_backend:
  run_critic(subtask, output, critic_backend) → verdict ∈ approve | flag | reject
  reject ⇒ status=&#x27;rejected&#x27;  (handoff_008+)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2b2f36;strokeColor=#7a8390;fontSize=11;fontColor=#e8eaed" vertex="1" parent="1"><mxGeometry x="800" y="500" width="540" height="60" as="geometry"/></mxCell>
<mxCell id="p3_jn" value="join_node" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e4a2e;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#e0f5e8" vertex="1" parent="1"><mxGeometry x="1020" y="580" width="100" height="40" as="geometry"/></mxCell>
<mxCell id="p3_jnnote" value="join_node:
• if intermediate wave (more wave-slices remain) → return {fanout_wave: w+1}, no message
• else: sort worker_results by idx, format combined assistant message,
        set error only when ALL workers failed (best-effort)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d2128;strokeColor=#d97a85;fontSize=10;align=left;spacingLeft=8;fontColor=#f8d7dc" vertex="1" parent="1"><mxGeometry x="800" y="630" width="540" height="70" as="geometry"/></mxCell>
<mxCell id="p3_raj" value="_route_after_join
• next wave → dispatch (loop)
• approval_required → approval
• else → END" style="rhombus;whiteSpace=wrap;html=1;fillColor=#5a3a14;strokeColor=#e0a050;fontSize=11;fontColor=#ffe6cc" vertex="1" parent="1"><mxGeometry x="860" y="710" width="420" height="60" as="geometry"/></mxCell>
<mxCell id="p3_ex" value="execute_node
(single-worker path)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e4a2e;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#e0f5e8" vertex="1" parent="1"><mxGeometry x="40" y="580" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="p3_ex_note" value="execute_node — single-worker fallback (used when fan-out doesn&#x27;t apply)
_send_to_backend  ·  _check_escalation_pin  ·  _pin_escalation on 429" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d381a;strokeColor=#c9b558;fontSize=10;align=left;spacingLeft=8;fontColor=#fff3a8" vertex="1" parent="1"><mxGeometry x="40" y="650" width="720" height="50" as="geometry"/></mxCell>
<mxCell id="p3_ap" value="approval_node
interrupt_before=[approval]
resume via /api/chat/approval" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e4a2e;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#e0f5e8" vertex="1" parent="1"><mxGeometry x="40" y="710" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="p3_state" value="AgentState additions for fan-out (graph.py)
• fanout_subtasks: Optional[list[{idx, text}]]
• worker_results:  Annotated[list[dict], operator.add]      (idx-tagged, sorted in join)
• fanout_width:    Optional[int]      (override)
• fanout_wave:     Optional[int]      (wave-chunk re-entry counter)
• escalation_backend: Optional[str]   (set by route_node)
• artifacts:       Annotated[list[dict], operator.add]      (parallel-write safe)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2b2f36;strokeColor=#7a8390;fontSize=11;fontColor=#e8eaed" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1320" height="130" as="geometry"/></mxCell>
<mxCell id="p3_locks" value="Locked decisions (2026-05-04, handoff_004)
• Trigger: threshold-based, _FANOUT_THRESHOLD=5 (separate from _BULK_DISPATCH_THRESHOLD=5)
• Topology: Shape A (Send-based) — revisable in 005 if test plan diverges
• Partial-failure: best-effort  (≥1 success ⇒ turn ok)
• 429 mid-flight: in-flight workers continue; failed retry on pinned backend
• Cost: pessimistic pre-flight per-backend; flat MAX_WORKER_USD removed
• Timeout: WORKER_TIMEOUT_SECONDS=180 per worker (not turn-level)
• Approval: pre-flight combined at dispatch
• Width: per-backend hard/soft caps + global=100; wave-chunk under cap, abort over global
• Critic (NEW-A): deferred to handoff_008 (now landed); NEW-B/NEW-C out of scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d381a;strokeColor=#c9b558;fontSize=10;align=left;spacingLeft=8;fontColor=#fff3a8" vertex="1" parent="1"><mxGeometry x="40" y="940" width="1320" height="175" as="geometry"/></mxCell>
<mxCell id="p3_e1" value="" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#c8cdd5;fontSize=10;fontColor=#e8eaed" edge="1" parent="1" source="p3_dec" target="p3_rt"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p3_e2" value="" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#c8cdd5;fontSize=10;fontColor=#e8eaed" edge="1" parent="1" source="p3_rt" target="p3_dis"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p3_e3" value="route_after_dispatch" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7eb6ff;fontSize=10;dashed=1;fontColor=#cfe2ff" edge="1" parent="1" source="p3_dis" target="p3_route"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p3_e4" value="list[Send] (fan-out)" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#c8cdd5;fontSize=10;fontColor=#e8eaed" edge="1" parent="1" source="p3_route" target="p3_send"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p3_e5" value="&quot;execute&quot; (single)" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#c8cdd5;fontSize=10;fontColor=#e8eaed" edge="1" parent="1" source="p3_route" target="p3_ex"><mxGeometry relative="1" as="geometry"/></mxCell>
