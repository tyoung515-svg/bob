[Unit]
Description=BoBClaw OpenAI-compatible bridge
Wants=bobclaw-core.service
After=bobclaw-core.service

[Service]
Type=simple
WorkingDirectory="@BOB_HOME@/bobclaw-core"
EnvironmentFile="@BOB_ENV_FILE@"
Environment="PYTHONPATH=@BOB_HOME@/bobclaw-core"
Environment=PYTHONUNBUFFERED=1
ExecStart="@BOB_HOME@/.venv/bin/python" tools/bob_bridge.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
