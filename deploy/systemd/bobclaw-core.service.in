[Unit]
Description=BoBClaw core
After=network.target

[Service]
Type=simple
WorkingDirectory="@BOB_HOME@/bobclaw-core"
EnvironmentFile="@BOB_ENV_FILE@"
Environment="PYTHONPATH=@BOB_HOME@/bobclaw-core"
Environment=PYTHONUNBUFFERED=1
Environment=BOBCLAW_CORE_PORT=7835
ExecStart="@BOB_HOME@/.venv/bin/python" start.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
