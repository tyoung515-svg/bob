[Unit]
AssertPathExists=/etc/systemd/system/bob-bridge@%i.service.d/identity.conf
Description=Bob OpenAI bridge (%i)
Requires=bob-firstboot.service bob-core@%i.service
After=bob-firstboot.service bob-core@%i.service

[Service]
Environment=BOB_EXECUTION_BOUNDARY=worker
User=bob-unprovisioned
Group=bob-unprovisioned
UMask=0077
WorkingDirectory=/var/lib/bob/family/%i/bob-memory
Environment=PYTHONPATH=/opt/bob/bobclaw-core
Environment=PYTHONUNBUFFERED=1
Environment=BOB_FAMILY_ROOT=/var/lib/bob/family
EnvironmentFile=/var/lib/bob/family/%i/bob-memory/bridge.env
ExecStart=/opt/bob/.venv/bin/python /opt/bob/bobclaw-core/tools/bob_bridge.py --port ${BOB_BRIDGE_PORT}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
