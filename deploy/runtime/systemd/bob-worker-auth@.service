[Unit]
AssertPathExists=/etc/systemd/system/bob-worker-auth@%i.service.d/identity.conf
Description=Bob shared-auth publisher (%i)
Requires=bob-worker-auth@%i.socket bob-worker-policy@%i.service
After=bob-worker-auth@%i.socket bob-worker@%i.socket bob-worker-policy@%i.service
BindsTo=bob-worker-policy@%i.service bob-worker@%i.socket bob-worker-auth@%i.socket

[Service]
InaccessiblePaths=-/var/lib/bob-worker-journals
# Fresh-lane provisioning installs exact User/Group and mount holes in a root-owned drop-in.
User=bob-unprovisioned
Group=bob-unprovisioned
SupplementaryGroups=
ExecStart=/opt/bob/.venv/bin/python -I -m core.worker.daemon /etc/bob/workers/%i.json --auth-only
WorkingDirectory=/
Environment=LANG=C.UTF-8
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=~@mount @reboot @swap @raw-io @privileged @obsolete @debug
# Denied syscalls fail with EPERM instead of SIGSYS, so probing tools (node, Chromium, codex) degrade cleanly.
SystemCallErrorNumber=EPERM
TemporaryFileSystem=/run:ro /var/lib/bob:ro
InaccessiblePaths=-/mnt -/media -/boot -/var/lib/docker -/var/lib/containerd -/proc/sys/fs/binfmt_misc
TasksMax=256
MemoryMax=2G
CPUQuota=200%
LimitNOFILE=1024
KillMode=control-group
TimeoutStopSec=5
Restart=on-failure
RestartSec=2
