[Unit]
Description=Bob credential journal boot repair (%i)

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
UMask=0077
ExecStart=/usr/local/bin/bob-settings %i repair
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/bob-settings
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
