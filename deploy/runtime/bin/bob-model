#!/opt/bob/.venv/bin/python
import json
import subprocess
import sys

sys.path.insert(0, '/usr/local/lib/bob_runtime')
from model import main

try:
    raise SystemExit(main())
except (OSError, ValueError, KeyError, subprocess.CalledProcessError):
    # Never forward exception text: it can carry subprocess input/environment.
    print(json.dumps({'event': 'error', 'detail': 'Model setup failed; check lane and runtime services'}), flush=True)
    raise SystemExit(1)
