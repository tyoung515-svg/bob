# CC session sidecar (runtime data, C3) + the federation registry (MS-1) — both hold
# machine-local absolute paths, so the data/ dir is ignored by contents (data/*). The ONLY
# tracked file there is the federation registry SCHEMA/EXAMPLE (no real secrets/paths beyond
# illustrative ones). `data/*` (not `data/`) leaves the dir itself includable so the re-include works.
bobclaw-core/data/*
!bobclaw-core/data/ledger_instances.example.json

# ── Workspace scratch (transient worker/audit/testing run artifacts) ──
# Single home for regenerable run output so it never clutters the repo root.
# Track only the README + the per-folder .gitkeep skeleton; ignore all artifacts.
/_workspace/*
!/_workspace/README.md
!/_workspace/worker/
!/_workspace/audit/
!/_workspace/testing/
!/_workspace/logs/
!/_workspace/runs/
_workspace/worker/*
_workspace/audit/*
_workspace/testing/*
_workspace/logs/*
_workspace/runs/*
!_workspace/*/.gitkeep

# ── tasks/** run-artifact captures (MS5-H1) ──────────────
# `_*.out` / `_*.txt` under tasks/ are regenerable baseline / audit / E2E capture files
# (pytest baselines, fleet-audit dumps, live-E2E logs). Ignore them so they stop cluttering
# `git status`. Re-include the handful already COMMITTED in prior sprints (MS-2 / MS-3) so this
# rule never silently drops an already-tracked file.
tasks/**/_*.out
tasks/**/_*.txt
!tasks/2026-06-30-mega-sprint-2/sprints/_baseline_core_c5.txt
!tasks/2026-06-30-mega-sprint-2/sprints/_baseline_core_g1.txt
!tasks/2026-06-30-mega-sprint-2/sprints/_baseline_memory_c5.txt
!tasks/2026-06-30-mega-sprint-2/sprints/_final_core_g4.txt
!tasks/2026-06-30-mega-sprint-2/sprints/_postchange_core_g4.txt
!tasks/2026-07-02-mega-sprint-3/lib/_x1_live_smoke.out
!tasks/2026-07-03-contemplate-forge/lib/_debate_run.out

# Kotlin incremental-compilation session data (generated by in-tree gradle runs)
bobclaw-app/.kotlin/

# LKS v5.5 experiment artifacts: keep code + writeups, drop bulky raw runs
tasks/2026-07-14-lks-v55-librarian/ablation/*.log
tasks/2026-07-14-lks-v55-librarian/curve/*.log

# Heavy ML experiment artifacts - never commit (public-push audit 2026-09-02)
# 2.8G training logs + 59M driver state
tasks/2026-07-25-moe-shrink-stage0/box-logs/
tasks/2026-07-25-moe-shrink-stage0/driver/
